{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["noyau", "tests", "vitest.config.ts", "app/src/synchro"],
  // L'adaptateur expo-sqlite est vérifié par le tsconfig de l'app.
  "exclude": ["app/src/synchro/base-locale-expo.ts"]
}
