{
  "expo": {
    "name": "Suivi nutritionnel",
    "slug": "suivi-nutritionnel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suivinutrition",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.suivinutritionnel.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.health.READ_STEPS", "android.permission.health.READ_WEIGHT", "android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La caméra sert à photographier tes repas pour les analyser.",
          "photosPermission": "La galerie sert à choisir la photo d'un repas à analyser."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 26 }
        }
      ],
      "react-native-health-connect",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ebd0a679-a6f0-4c10-8b64-fbbaa8dfe6b8"
      }
    }
  }
}
