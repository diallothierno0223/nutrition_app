{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@noyau": ["../noyau/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Les tests de synchro et l'adaptateur node:sqlite tournent dans Node : ils sont vérifiés par le tsconfig racine.
  "exclude": ["node_modules", "src/**/*.test.ts", "src/synchro/base-locale-node.ts"]
}
